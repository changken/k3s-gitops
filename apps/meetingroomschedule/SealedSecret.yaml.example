# 範本：副檔名不是 .yaml，ArgoCD 不會同步這個檔案。
# 真正的檔案由 `bash scripts/seal-secrets.sh meetingroomschedule` 產生為 SealedSecret.yaml，
# 不要手動填值，也不要把明文寫進來。
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: meetingroomschedule-secrets
  namespace: meetingroomschedule
spec:
  encryptedData:
    ConnectionStrings__Database: <kubeseal 產生> # Supabase pooler session mode（port 5432）
    Supabase__Url: <kubeseal 產生>
    Supabase__AnonKey: <kubeseal 產生>
    DemoSeed__EmailDomain: <kubeseal 產生>
  template:
    metadata:
      name: meetingroomschedule-secrets
      namespace: meetingroomschedule
